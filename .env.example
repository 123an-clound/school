# SUPABASE CONFIGURATION (new API keys; projects created since Nov 2025 have no anon/service_role keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only (never NEXT_PUBLIC_), bypasses RLS: public form Server Actions + admin invite script only
SUPABASE_SECRET_KEY=sb_secret_xxx

# CLOUDFLARE TURNSTILE — values below are Cloudflare's always-pass test keys for local dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# APPLICATION SETTINGS
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Playwright admin tests (npx playwright test); leave empty to skip them
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
